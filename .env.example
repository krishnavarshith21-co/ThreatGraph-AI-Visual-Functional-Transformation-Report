# === ThreatGraph AI Environment Configuration Template ===

# Backend API
PORT=8000
HOST=0.0.0.0
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# FalkorDB Cloud Deployment
FALKORDB_HOST=r-6jissuruar.instance-9x47fsdej.hc-7up0crkyn.ap-south-1.aws.f2e0a955bb84.cloud
FALKORDB_PORT=64891
FALKORDB_USERNAME=threatgraph_app
FALKORDB_PASSWORD=your-falkordb-password
FALKORDB_GRAPH_NAME=threatgraph

# TLS / Encryption Hardening:
# Note: FalkorDB Cloud Free Tier uses plain TCP (FALKORDB_SSL=false).
# Paid tiers (Startup/Pro/Enterprise) provide verified TLS (FALKORDB_SSL=true).
FALKORDB_SSL=false
FALKORDB_REQUIRE_TLS=false
FALKORDB_SSL_CHECK_HOSTNAME=true
FALKORDB_SSL_CERT_REQS=required
# FALKORDB_SSL_CA_CERTS=/path/to/custom_ca.pem

# Optional full URL format:
# FALKORDB_URL=falkor://threatgraph_app:your-password@your-host:64891

# LLM (Google Gemini)
GOOGLE_API_KEY=your-google-api-key
LLM_MODEL=gemini-2.0-flash

# Supabase Auth Configuration (Frontend & Backend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Investigation limits
MAX_INVESTIGATION_STEPS=15
MAX_GRAPH_DEPTH=4
